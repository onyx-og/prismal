{
  // This file is not used in compilation. It is here just for a nice editor experience.
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@prismal/docs-theme": ["../docs-theme"],
      "@site/*": ["*"],
      "styles": ["../react/src/styles"],
      "styles/*": ["../react/src/styles/*"],
      "components": ["../react/src/components"],
      "components/*": ["../react/src/components/*"],
      "hooks": ["../react/src/hooks"],
      "hooks/*": ["../react/src/hooks/*"],
      "hooks/": ["../react/src/hooks/index", "../react/src/hooks"],
      "utils": ["../react/src/utils"],
      "utils/*": ["../react/src/utils/*"],
      "utils/": ["../react/src/utils/index", "../react/src/utils"]
    }
  },
  "exclude": [".docusaurus", "build"]
}
